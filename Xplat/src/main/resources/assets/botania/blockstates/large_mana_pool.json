{
  "multipart": [
    {
      "apply": {
        "model": "botania:block/large_mana_pool_floor"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "botania:block/large_mana_pool_rim"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "botania:block/large_mana_pool_rim",
        "y": 90
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "botania:block/large_mana_pool_rim",
        "y": 180
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "botania:block/large_mana_pool_rim",
        "y": 270
      }
    },
    {
      "when": {
        "north": "true",
        "east": "true",
        "north_east": "false"
      },
      "apply": {
        "model": "botania:block/large_mana_pool_post"
      }
    },
    {
      "when": {
        "east": "true",
        "south": "true",
        "south_east": "false"
      },
      "apply": {
        "model": "botania:block/large_mana_pool_post",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true",
        "west": "true",
        "south_west": "false"
      },
      "apply": {
        "model": "botania:block/large_mana_pool_post",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true",
        "north": "true",
        "north_west": "false"
      },
      "apply": {
        "model": "botania:block/large_mana_pool_post",
        "y": 270
      }
    }
  ]
}
